{
  "extends": "./tsconfig.base.json",
  "include": ["test", "scripts/ui-assets.ts", "scripts/ui-screenshots.ts", "ui-assets", "site/src/playground/engine.ts"],
  "references": [
    { "path": "tsconfig.src.json" }
  ],
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "imposters/test/*": ["./test/*"],
      "imposters/*": ["./src/*"]
    }
  }
}
