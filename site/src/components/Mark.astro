---
// The brace-face mark. Its colours follow the theme tokens.
interface Props {
  size?: number
  class?: string
}
const { size = 34, class: className } = Astro.props
---

<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <path
    d="M20 12c-6 0-7 4-7 9s0 8-6 11c6 3 6 6 6 11s1 9 7 9M44 12c6 0 7 4 7 9s0 8 6 11c-6 3-6 6-6 11s-1 9-7 9"
    fill="none"
    stroke="var(--im-mark-brace)"
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <ellipse class="mark-eye" cx="26" cy="30" rx="4.5" ry="3" fill="var(--im-mark-eyes)"></ellipse>
  <ellipse class="mark-eye" cx="38" cy="30" rx="4.5" ry="3" fill="var(--im-mark-eyes)"></ellipse>
</svg>
