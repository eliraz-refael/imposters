---
// The layout of the site's own pages (landing, roadmap, 404). The docs use Starlight's.
import "../styles/theme.css"
import "../styles/site.css"
import Mark from "../components/Mark.astro"
import { links, withBase } from "../lib/links"

interface Props {
  title: string
  description: string
  current?: "home" | "roadmap" | "404"
}

const { current, description, title } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(withBase("/og.png"), Astro.site)
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {current === "404" ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#0a0d0b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Imposters" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {current !== "404" && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="imposters: your dependencies, in disguise" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Same storage key and rule as Starlight, so the landing and the docs agree on the theme */}
    <script is:inline>
      ;(() => {
        let stored = ""
        try {
          stored = localStorage.getItem("starlight-theme") || ""
        } catch {}
        const theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark"
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <div class="page">
      <header class="site-header wrap">
        <a href={links.home} class="brand" aria-label="imposters home">
          <Mark size={34} />
          <span>imposters</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href={links.docs}>./docs</a>
          <a href={links.roadmap} aria-current={current === "roadmap" ? "page" : undefined}>./roadmap</a>
          <a href={links.github}>./github</a>
          <button type="button" class="theme-toggle" aria-label="Switch theme" title="Switch theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path></svg
            >
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path></svg
            >
          </button>
          <a href={links.gettingStarted} class="nav-start">start</a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer wrap">
        <span>MIT · typescript + effect · node or bun</span>
        <nav aria-label="Footer">
          <a href={links.docs}>docs</a>
          <a href={links.roadmap}>roadmap</a>
          <a href={links.github}>github</a>
          <a href={links.npm}>npm</a>
        </nav>
      </footer>
    </div>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle")
      const label = () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light"
        toggle?.setAttribute("aria-label", `Switch to ${next} theme`)
        toggle?.setAttribute("title", `Switch to ${next} theme`)
      }
      label()
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light"
        document.documentElement.dataset.theme = next
        try {
          localStorage.setItem("starlight-theme", next)
        } catch {
          // Storage blocked: the choice lasts for this page only
        }
        label()
      })
    </script>
  </body>
</html>
