{
  "extends": "./tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "imposters/*": ["./src/*"]
    }
  }
}
